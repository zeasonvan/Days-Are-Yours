{
  "name": "@local/days",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DAYS — a playful personal life assistant for countdowns, holidays, leave planning, memories and everyday joy.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "docs",
    "assets",
    "tests"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
